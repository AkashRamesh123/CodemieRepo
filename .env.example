# Environment variable template for CodemieRepo.
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file – it is listed in .gitignore.

# Fixer.io API key for the Currency Converter project.
# Get one at https://fixer.io/product
CURRENCY_CONVERTER_API_KEY=replace_me

# OpenWeatherMap API key for the Weather Fetcher project.
# Get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=replace_me

# Log level for all project scripts (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Defaults to INFO when not set.
LOG_LEVEL=INFO
