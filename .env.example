# CodemieRepo – environment variable template
# Copy this file to .env for local development (NEVER commit .env).
# All values here are placeholders only.

# OpenWeatherMap API key (Fetch_current_weather project)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Fixer.io API key (Currency_converter project)
FIXER_API_KEY=your_fixer_io_api_key_here

# Log level for application output (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
